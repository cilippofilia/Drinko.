    "Redesigned Cocktails and Learn: switch between cards and list, and jump back in from your recently viewed drinks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu gestaltete Bereiche „Cocktails“ und „Lernen“: Wechseln Sie zwischen Karten und Liste, und machen Sie direkt bei Ihren zuletzt angesehenen Drinks weiter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cócteles y Aprender rediseñados: alterne entre tarjetas y lista, y retome lo que vio recientemente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocktails et Apprendre repensés : passez des cartes à la liste et reprenez là où vous en étiez grâce à vos consultations récentes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocktail e Impara ridisegnati: passi dalle schede all'elenco e riprenda da dove aveva lasciato con i drink visti di recente"
          }
        }
      }
    },
